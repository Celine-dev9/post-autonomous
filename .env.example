# ==========================================
# AUTONOMOUS SOCIAL PUBLISHER CONFIGURATION
# ==========================================

# --- APPLICATION ---
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Europe/Bucharest
DRY_RUN=false

# --- AI PROVIDER ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3

# --- RESEARCH ---
RSS_ENABLED=true
RSS_SOURCES_PATH=config/rss-sources.json
MAX_ARTICLE_AGE_DAYS=3
MAX_RESEARCH_ITEMS=25

# --- DATABASE (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_FALLBACK_MEMORY=true

# --- MEDIA GENERATION & HOSTING ---
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
VIDEO_PROVIDER=mock
VIDEO_API_KEY=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# --- SCHEDULER ---
POSTS_PER_DAY=2
POST_TIME_1=10:00
POST_TIME_2=17:00
RANDOMIZE_POST_TIME=true
RANDOM_WINDOW_MINUTES=30

# --- PLATFORM CREDENTIALS ---
# X (Twitter)
X_ENABLED=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Facebook Pages
FACEBOOK_ENABLED=true
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# Instagram
INSTAGRAM_ENABLED=true
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_ENABLED=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_PERSON_URN=

# YouTube
YOUTUBE_ENABLED=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# --- SECURITY & ENCRYPTION ---
# 32-byte hex or base64 key for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- ALERTING & MONITORING ---
ALERT_WEBHOOK_URL=
QUALITY_THRESHOLD=80
